## Post-Deploy Checklist

```bash
# 1. Verify WAF deployed successfully in us-east-1
aws wafv2 list-web-acls \
  --scope CLOUDFRONT \
  --region us-east-1 \
  --query 'WebACLs[?contains(Name,`FixyachipsShield`)].[Name,Id]' \
  --output table

# 2. Store certificate ARN in SSM (never in source control again)
aws ssm put-parameter \
  --name /fixyachips/prod/cert-arn \
  --value "arn:aws:acm:us-east-1:ACCOUNT:certificate/ID" \
  --type SecureString \
  --overwrite

# 3. Confirm DynamoDB CMK encryption is active
aws dynamodb describe-table \
  --table-name $(aws cloudformation describe-stacks \
    --stack-name YOUR-STACK \
    --query 'Stacks[0].Outputs[?OutputKey==`StudentTableName`].OutputValue' \
    --output text) \
  --query 'Table.SSEDescription'

# 4. Test that 404 now returns HTTP 404 (not 200)
curl -o /dev/null -s -w "%{http_code}" \
  https://fixyachips.com/this-page-does-not-exist

# 5. Verify CloudFront access logs are landing in S3
aws s3 ls s3://fixyachips-logs-ACCOUNT-prod/cloudfront/ \
  --recursive | head -5

# 6. Test CSP header does not contain unsafe-inline
curl -I https://fixyachips.com \
  | grep -i content-security-policy

# 7. Test Cognito advanced security is active
aws cognito-idp describe-user-pool \
  --user-pool-id $(aws cloudformation describe-stacks \
    --stack-name YOUR-STACK \
    --query 'Stacks[0].Outputs[?OutputKey==`UserPoolId`].OutputValue' \
    --output text) \
  --query 'UserPool.UserPoolAddOns'
```
