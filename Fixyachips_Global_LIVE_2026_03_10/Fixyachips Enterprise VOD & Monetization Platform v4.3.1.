  # ----------------------------------------------------------
  SignupDLQ:
    Type: AWS::SQS::Queue
    Properties:
      QueueName: !Sub 'FixyachipsSignupDLQ-${AWS::StackName}'
      MessageRetentionPeriod: 1209600
      SqsManagedSseEnabled: true
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment

  StripeWebhookDLQ:
    Type: AWS::SQS::Queue
    Properties:
      QueueName: !Sub 'FixyachipsStripeWebhookDLQ-${AWS::StackName}'
      MessageRetentionPeriod: 1209600
      SqsManagedSseEnabled: true
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment

  # ----------------------------------------------------------
  # IAM MASTER ROLE
  # FIXED: Added KMS decrypt permissions for DynamoDB CMK
  # FIXED: Scoped MediaConvert resource more precisely
  # ----------------------------------------------------------
  FixyachipsMasterRole:
    Type: AWS::IAM::Role
    Properties:
      Description: Lambda execution role - least privilege for all workers
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole
        - arn:aws:iam::aws:policy/AWSXRayDaemonWriteAccess
      Policies:
        - PolicyName: SecretsManagerStripeAccess
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action: secretsmanager:GetSecretValue
                Resource: !Ref StripeApiSecret
              - Effect: Allow
                Action:
                  - kms:Decrypt
                  - kms:DescribeKey
                Resource: !GetAtt SecretsKMSKey.Arn

        - PolicyName: MediaConvertJobSubmit
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - mediaconvert:CreateJob
                  - mediaconvert:GetJob
                  - mediaconvert:ListJobs
                Resource:
                  - !Sub 'arn:aws:mediaconvert:${AWS::Region}:${AWS::AccountId}:queues/*'
                  - !Sub 'arn:aws:mediaconvert:${AWS::Region}:${AWS::AccountId}:jobs/*'
              - Effect: Allow
                Action: iam:PassRole
                Resource: !GetAtt MediaConvertRole.Arn
                Condition:
                  StringEquals:
                    iam:PassedToService: mediaconvert.amazonaws.com

        - PolicyName: S3ContentAccess
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                Resource:
                  - !Sub 'arn:aws:s3:::${StreamingVideoBucket}/raw/*'
                  - !Sub 'arn:aws:s3:::${StreamingVideoBucket}/videos/*'
              - Effect: Allow
                Action: s3:ListBucket
                Resource: !Sub 'arn:aws:s3:::${StreamingVideoBucket}'
                Condition:
                  StringLike:
                    s3:prefix: ['raw/*', 'videos/*']

        - PolicyName: DynamoDBStudentAccess
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - dynamodb:GetItem
                  - dynamodb:PutItem
                  - dynamodb:UpdateItem
                  - dynamodb:Query
                Resource:
                  - !GetAtt StudentTable.Arn
                  - !Sub '${StudentTable.Arn}/index/*'
              - Effect: Allow
                Action:
                  - kms:Decrypt
                  - kms:GenerateDataKey
                  - kms:DescribeKey
                Resource: !GetAtt DynamoDBKMSKey.Arn

        - PolicyName: SESSendEmail
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ses:SendEmail
                  - ses:SendTemplatedEmail
                Resource:
                  - !Sub 'arn:aws:ses:${AWS::Region}:${AWS::AccountId}:identity/fixyachips.com'
                  - !Sub 'arn:aws:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/*'

        - PolicyName: DLQAccess
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action: sqs:SendMessage
                Resource:
                  - !GetAtt SignupDLQ.Arn
                  - !GetAtt StripeWebhookDLQ.Arn
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment

