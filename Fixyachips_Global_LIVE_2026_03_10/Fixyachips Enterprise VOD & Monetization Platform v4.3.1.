    Properties:
      Name: !Sub 'Fixyachips/StripeCredentials/${Environment}/${AWS::StackName}'
      Description: Stripe API keys and Webhook signing secrets
      KmsKeyId: !Ref SecretsKMSKey
      SecretString: !Sub |
        {
          "api_key": "REPLACE_WITH_REAL_STRIPE_KEY_AFTER_DEPLOY",
          "webhook_secret": "REPLACE_WITH_REAL_WEBHOOK_SECRET_AFTER_DEPLOY",
          "environment": "${Environment}",
          "note": "Update via: aws secretsmanager put-secret-value --secret-id <arn> --secret-string <value>"
        }
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment
        - Key: DataClassification
          Value: Highly-Confidential
        - Key: RotationRequired
          Value: 'true'

  StripeApiSecretResourcePolicy:
    Type: AWS::SecretsManager::ResourcePolicy
    Properties:
      SecretId: !Ref StripeApiSecret
      BlockPublicPolicy: true
      ResourcePolicy:
        Version: '2012-10-17'
        Statement:
          - Sid: AllowLambdaReadOnly
            Effect: Allow
            Principal:
              AWS: !GetAtt FixyachipsMasterRole.Arn
            Action: secretsmanager:GetSecretValue
