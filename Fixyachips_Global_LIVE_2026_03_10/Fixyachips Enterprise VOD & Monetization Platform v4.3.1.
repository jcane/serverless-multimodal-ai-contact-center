**Attack vector**: Any attacker can POST a fake `checkout.session.completed` event to your API endpoint and grant themselves full VOD access. No authentication, no HMAC verification.

```python
# CORRECTED CODE - Production-Grade Stripe Webhook Handler
import json
import boto3
import os
import logging
import hmac
import hashlib
import time
from botocore.exceptions import ClientError

logger = logging.getLogger()
logger.setLevel(logging.INFO)

def verify_stripe_signature(payload_body: str, sig_header: str, webhook_secret: str) -> bool:
    """
    Verify Stripe webhook signature using HMAC-SHA256.
    Implements Stripe's webhook signature verification spec exactly.
    Ref: https://stripe.com/docs/webhooks/signatures
    """
    try:
        # Parse the Stripe-Signature header
        elements = sig_header.split(',')
        timestamp = None
        signatures = []

        for element in elements:
            key, value = element.split('=', 1)
            if key == 't':
                timestamp = int(value)
            elif key == 'v1':
                signatures.append(value)

        if not timestamp or not signatures:
            logger.error('Missing timestamp or signatures in Stripe-Signature header')
            return False

        # Replay attack protection: reject events older than 5 minutes
        current_time = int(time.time())
        tolerance_seconds = 300  # 5 minutes per Stripe recommendation
        if abs(current_time - timestamp) > tolerance_seconds:
            logger.error(
                'Stripe webhook timestamp too old. Age: %d seconds',
                abs(current_time - timestamp)
            )
            return False

        # Construct signed payload: timestamp.payload
        signed_payload = f'{timestamp}.{payload_body}'

        # Compute expected HMAC-SHA256 signature
        expected_sig = hmac.new(
            webhook_secret.encode('utf-8'),
            signed_payload.encode('utf-8'),
            hashlib.sha256
        ).hexdigest()

        # Constant-time comparison to prevent timing attacks
        return any(
            hmac.compare_digest(expected_sig, sig)
            for sig in signatures
        )

    except Exception as e:
        logger.error('Signature verification error: %s', str(e))
        return False


def get_stripe_secrets(secret_arn: str) -> dict:
    """Retrieve Stripe credentials from Secrets Manager with error handling."""
    try:
        client = boto3.client('secretsmanager')
        response = client.get_secret_value(SecretId=secret_arn)
        return json.loads(response['SecretString'])
    except ClientError as e:
        logger.error('Failed to retrieve secrets: %s', e.response['Error']['Code'])
        raise


def get_or_create_student_id(email: str) -> str:
    """
    CRITICAL FIX: The original code used customer_email as DynamoDB Key.
    StudentID is the hash key, not Email. This caused silent lookup failures.
    """
    import uuid
    return str(uuid.uuid5(uuid.NAMESPACE_URL, f'fixyachips:{email}'))


def lambda_handler(event, context):
    """
    Stripe webhook processor with full signature verification,
    replay attack protection, and idempotency handling.
    """
    try:
        # Extract raw body BEFORE any parsing (required for HMAC verification)
        payload_body = event.get('body', '')
        if not payload_body:
            logger.warning('Empty webhook body received')
            return {'statusCode': 400, 'body': json.dumps({'error': 'Empty body'})}

        # Extract Stripe signature header
        headers = event.get('headers', {})
        # API Gateway may lowercase headers
        sig_header = (
            headers.get('Stripe-Signature') or
            headers.get('stripe-signature') or
            ''
        )

        if not sig_header:
            logger.error('Missing Stripe-Signature header')
            # Return 400 NOT 200 - Stripe will retry on 4xx/5xx
            return {'statusCode': 400, 'body': json.dumps({'error': 'Missing signature'})}

        # Retrieve webhook secret from Secrets Manager
        secrets = get_stripe_secrets(os.environ['SECRET_ARN'])
        webhook_secret = secrets.get('webhook_secret', '')

        if not webhook_secret or webhook_secret == 'whsec_placeholder':
            logger.error('Invalid webhook secret configured')
            return {'statusCode': 500, 'body': json.dumps({'error': 'Configuration error'})}

        # CRITICAL: Verify signature before processing ANY business logic
        if not verify_stripe_signature(payload_body, sig_header, webhook_secret):
            logger.error('Stripe signature verification FAILED')
            return {'statusCode': 403, 'body': json.dumps({'error': 'Invalid signature'})}

        # Parse event after verification
        event_dict = json.loads(payload_body)
        event_type = event_dict.get('type')
        stripe_event_id = event_dict.get('id', 'unknown')

        logger.info('Processing verified Stripe event: %s (id: %s)', event_type, stripe_event_id)

        if event_type == 'checkout.session.completed':
            session = event_dict.get('data', {}).get('object', {})
            customer_email = session.get('customer_details', {}).get('email', '').lower().strip()
            payment_status = session.get('payment_status')

            if not customer_email:
                logger.error('No customer email in checkout session')
                return {'statusCode': 200, 'body': json.dumps({'received': True})}

            # Only provision access for paid sessions
            if payment_status != 'paid':
                logger.warning(
                    'Checkout session not paid. Status: %s, Email: %s',
                    payment_status,
                    customer_email
                )
                return {'statusCode': 200, 'body': json.dumps({'received': True})}

            # CRITICAL FIX: Derive StudentID using same uuid5 logic as SignupWorker
            student_id = get_or_create_student_id(customer_email)

            table = boto3.resource('dynamodb').Table(os.environ['TABLE_NAME'])

            # Use condition expression for idempotency - prevent double-provisioning
            try:
                table.update_item(
                    Key={'StudentID': student_id},
                    UpdateExpression=(
                        'SET #s = :status, Entitlement = :ent, '
                        'Email = :email, StripeEventId = :event_id, '
                        'UpdatedAt = :updated_at'
                    ),
                    ExpressionAttributeNames={'#s': 'Status'},
                    ExpressionAttributeValues={
                        ':status': 'ACTIVE_SUBSCRIBER',
                        ':ent': 'VOD_FULL_ACCESS',
                        ':email': customer_email,
                        ':event_id': stripe_event_id,
                        ':updated_at': __import__('datetime').datetime.now(
                            __import__('datetime').timezone.utc
                        ).isoformat()
                    }
                )
                logger.info(
                    'Provisioned VOD access for student_id: %s (event: %s)',
                    student_id,
                    stripe_event_id
                )
            except ClientError as e:
                logger.error('DynamoDB update failed: %s', e.response['Error']['Code'])
                # Return 500 so Stripe retries
                return {'statusCode': 500, 'body': json.dumps({'error': 'Database error'})}

        elif event_type == 'customer.subscription.deleted':
            # Handle subscription cancellation - revoke access
            session = event_dict.get('data', {}).get('object', {})
            customer_id = session.get('customer')
            logger.info('Subscription cancelled for customer: %s', customer_id)
            # TODO: Implement access revocation logic

        else:
            logger.info('Unhandled Stripe event type: %s', event_type)

        # Always return 200 to Stripe for processed events
        return {'statusCode': 200, 'body': json.dumps({'received': True})}

    except json.JSONDecodeError as e:
        logger.error('Invalid JSON in webhook body: %s', str(e))
        return {'statusCode': 400, 'body': json.dumps({'error': 'Invalid JSON'})}

    except Exception as err:
        logger.error('Webhook processing failed: %s', str(err), exc_info=True)
        # Return 500 so Stripe retries the webhook
        return {'statusCode': 500, 'body': json.dumps({'error': 'Internal error'})}
