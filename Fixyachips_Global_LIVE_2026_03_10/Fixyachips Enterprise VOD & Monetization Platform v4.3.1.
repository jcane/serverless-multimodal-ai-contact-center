            ResponsePagePath: /error/403.html
            ErrorCachingMinTTL: 30
          - ErrorCode: 404
            ResponseCode: 404
            ResponsePagePath: /error/404.html
            ErrorCachingMinTTL: 30
          - ErrorCode: 500
            ResponseCode: 500
            ResponsePagePath: /error/500.html
            ErrorCachingMinTTL: 0
          - ErrorCode: 502
            ResponseCode: 502
            ResponsePagePath: /error/500.html
            ErrorCachingMinTTL: 0
          - ErrorCode: 503
            ResponseCode: 503
            ResponsePagePath: /error/500.html
            ErrorCachingMinTTL: 0
