  # ----------------------------------------------------------
  # LAMBDA WORKERS
  # ----------------------------------------------------------

  # Signup Worker Log Group
  SignupWorkerLogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub '/aws/lambda/FixyachipsSignupWorker-${AWS::StackName}'
      RetentionInDays: 30

  # FIXED: Full production-grade signup handler with validation
  SignupWorker:
    Type: AWS::Lambda::Function
    DependsOn: SignupWorkerLogGroup
    Properties:
      FunctionName: !Sub 'FixyachipsSignupWorker-${AWS::StackName}'
      Description: Waitlist signup handler with input validation and duplicate prevention
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt FixyachipsMasterRole.Arn
      Timeout: 29
      MemorySize: 256
      ReservedConcurrentExecutions: 100
      TracingConfig:
        Mode: Active
      DeadLetterConfig:
        TargetArn: !GetAtt SignupDLQ.Arn
      Environment:
        Variables:
          TABLE_NAME: !Ref StudentTable
          ADMIN_EMAIL: !Ref AdminEmail
          ALLOWED_ORIGIN: 'https://fixyachips.com'
          ENVIRONMENT: !Ref Environment
          LOG_LEVEL: !If [IsProduction, 'WARNING', 'INFO']
      Code:
        ZipFile: |
          import json
          import boto3
          import uuid
          import os
          import re
          import logging
          from datetime import datetime, timezone
          from botocore.exceptions import ClientError

          logger = logging.getLogger()
          logger.setLevel(os.environ.get('LOG_LEVEL', 'WARNING'))

          EMAIL_PATTERN = re.compile(
              r'^[a-zA-Z0-9._%+\-]{1,64}@[a-zA-Z0-9.\-]{1,253}\.[a-zA-Z]{2,}$'
          )
          NAME_PATTERN = re.compile(r'^[a-zA-Z\s\'\-\.]{2,100}$')
          ALLOWED_ORIGIN = os.environ.get('ALLOWED_ORIGIN', 'https://fixyachips.com')

          CORS_HEADERS = {
              'Access-Control-Allow-Origin': ALLOWED_ORIGIN,
              'Access-Control-Allow-Headers': 'Content-Type',
              'Access-Control-Allow-Methods': 'POST, OPTIONS',
              'Vary': 'Origin'
          }

          def validate_input(email, name):
              if not email or len(email) > 254:
                  return False, 'Invalid email address'
              if not EMAIL_PATTERN.match(email):
                  return False, 'Invalid email format'
              if not name or len(name) < 2 or len(name) > 100:
                  return False, 'Name must be between 2 and 100 characters'
              if not NAME_PATTERN.match(name):
                  return False, 'Name contains invalid characters'
              return True, ''

          def lambda_handler(event, context):
              if event.get('httpMethod') == 'OPTIONS':
                  return {'statusCode': 200, 'headers': CORS_HEADERS, 'body': ''}

              if event.get('httpMethod') != 'POST':
                  return {'statusCode': 405, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Method not allowed'})}
              try:
                  raw_body = event.get('body', '') or ''
                  if len(raw_body) > 10240:
                      return {'statusCode': 413, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': 'Request too large'})}

                  try:
                      body = json.loads(raw_body)
                  except json.JSONDecodeError:
                      return {'statusCode': 400, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': 'Invalid JSON'})}

                  email = str(body.get('email', '')).strip().lower()
                  name = str(body.get('name', '')).strip()

                  is_valid, error_msg = validate_input(email, name)
                  if not is_valid:
                      return {'statusCode': 400, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': error_msg})}

                  student_id = str(uuid.uuid5(uuid.NAMESPACE_URL, 'fixyachips:' + email))
                  now = datetime.now(timezone.utc).isoformat()

                  table = boto3.resource('dynamodb').Table(os.environ['TABLE_NAME'])

                  try:
                      table.put_item(
                          Item={
                              'StudentID': student_id,
                              'Name': name,
                              'Email': email,
                              'Status': 'WAITLIST',
                              'CreatedAt': now
                          },
                          ConditionExpression=(
                              'attribute_not_exists(StudentID) OR #s = :waitlist'
                          ),
                          ExpressionAttributeNames={'#s': 'Status'},
                          ExpressionAttributeValues={':waitlist': 'WAITLIST'}
                      )
                  except ClientError as e:
                      if e.response['Error']['Code'] == 'ConditionalCheckFailedException':
                          logger.info('Duplicate signup for existing subscriber')
                          return {'statusCode': 200, 'headers': CORS_HEADERS,
                                  'body': json.dumps({'status': 'success'})}
                      raise

                  return {'statusCode': 200, 'headers': CORS_HEADERS,
                          'body': json.dumps({'status': 'success'})}

              except Exception as exc:
                  logger.error('Signup error: %s', str(exc), exc_info=True)
                  return {'statusCode': 500, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Internal server error'})}

  SignupWorkerPermission:
    Type: AWS::Lambda::Permission
    Properties:
      Action: lambda:InvokeFunction
      FunctionName: !Ref SignupWorker
      Principal: apigateway.amazonaws.com
      SourceArn: !Sub 'arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${PlatformApi}/*/*/*'

