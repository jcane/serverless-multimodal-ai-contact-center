```python
# CORRECTED Signup Handler - Production Grade
import json
import boto3
import uuid
import os
import re
import logging
from datetime import datetime, timezone
from botocore.exceptions import ClientError

logger = logging.getLogger()
logger.setLevel(os.environ.get('LOG_LEVEL', 'WARNING'))

# Compiled regex patterns (module-level for Lambda reuse across invocations)
EMAIL_PATTERN = re.compile(
    r'^[a-zA-Z0-9._%+\-]{1,64}@[a-zA-Z0-9.\-]{1,253}\.[a-zA-Z]{2,}$'
)
NAME_PATTERN = re.compile(r'^[a-zA-Z\s\'\-\.]{2,100}$')

CORS_HEADERS = {
    'Access-Control-Allow-Origin': os.environ.get('ALLOWED_ORIGIN', 'https://fixyachips.com'),
    'Access-Control-Allow-Headers': 'Content-Type',
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Vary': 'Origin'
}


def validate_input(email: str, name: str) -> tuple[bool, str]:
    """Validate and sanitize user inputs. Returns (is_valid, error_message)."""
    if not email or len(email) > 254:
        return False, 'Invalid email address'

    if not EMAIL_PATTERN.match(email):
        return False, 'Invalid email format'

    if not name or len(name) < 2 or len(name) > 100:
        return False, 'Name must be between 2 and 100 characters'

    if not NAME_PATTERN.match(name):
        return False, 'Name contains invalid characters'

    return True, ''


def lambda_handler(event, context):
    # Handle CORS preflight
    if event.get('httpMethod') == 'OPTIONS':
        return {'statusCode': 200, 'headers': CORS_HEADERS, 'body': ''}

    # Only accept POST
    if event.get('httpMethod') != 'POST':
        return {
            'statusCode': 405,
            'headers': CORS_HEADERS,
            'body': json.dumps({'error': 'Method not allowed'})
        }

    try:
        # Safe JSON parsing with size limit
        raw_body = event.get('body', '') or ''
        if len(raw_body) > 10240:  # 10KB max body
            return {
                'statusCode': 413,
                'headers': CORS_HEADERS,
                'body': json.dumps({'error': 'Request body too large'})
            }

        try:
            body = json.loads(raw_body)
        except json.JSONDecodeError:
            return {
                'statusCode': 400,
                'headers': CORS_HEADERS,
                'body': json.dumps({'error': 'Invalid JSON'})
            }

        email = str(body.get('email', '')).strip().lower()
        name = str(body.get('name', '')).strip()

        # Validate inputs
        is_valid, error_msg = validate_input(email, name)
        if not is_valid:
            return {
                'statusCode': 400,
                'headers': CORS_HEADERS,
                'body': json.dumps({'error': error_msg})
            }

        # Deterministic ID prevents duplicate signups
        student_id = str(uuid.uuid5(uuid.NAMESPACE_URL, f'fixyachips:{email}'))
        now = datetime.now(timezone.utc).isoformat()

        table = boto3.resource('dynamodb').Table(os.environ['TABLE_NAME'])

        # Conditional write - prevent overwriting ACTIVE_SUBSCRIBER records
        try:
            table.put_item(
                Item={
                    'StudentID': student_id,
                    'Name': name,
                    'Email': email,
                    'Status': 'WAITLIST',
                    'CreatedAt': now,
                    'IPAddress': event.get('requestContext', {})
                                      .get('identity', {})
                                      .get('sourceIp', 'unknown'),
                    'UserAgent': event.get('headers', {})
                                      .get('User-Agent', 'unknown')[:200]
                },
                ConditionExpression=(
                    'attribute_not_exists(StudentID) OR '
                    '#s = :waitlist_status'
                ),
                ExpressionAttributeNames={'#s': 'Status'},
                ExpressionAttributeValues={':waitlist_status': 'WAITLIST'}
            )
        except ClientError as e:
            if e.response['Error']['Code'] == 'ConditionalCheckFailedException':
                # Already an active subscriber - return success silently
                logger.info('Duplicate signup attempt for existing subscriber: %s', student_id)
                return {
                    'statusCode': 200,
                    'headers': CORS_HEADERS,
                    'body': json.dumps({'status': 'success'})
                }
            raise

        logger.info('New waitlist signup: %s', student_id)
        return {
            'statusCode': 200,
            'headers': CORS_HEADERS,
            'body': json.dumps({'status': 'success'})
        }

    except Exception as exc:
        logger.error('Signup error: %s', str(exc), exc_info=True)
        return {
            'statusCode': 500,
            'headers': CORS_HEADERS,
            'body': json.dumps({'error': 'Internal server error'})
        }
