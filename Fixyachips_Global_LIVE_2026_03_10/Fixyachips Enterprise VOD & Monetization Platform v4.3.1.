    Export:
      Name: !Sub '${AWS::StackName}-SignupApiUrl'

  S3BucketName:
    Description: Video and content storage bucket
    Value: !Ref StreamingVideoBucket
    Export:
      Name: !Sub '${AWS::StackName}-S3Bucket'

  UserPoolId:
    Description: Cognito User Pool ID
    Value: !Ref FixyachipsUserPool
    Export:
      Name: !Sub '${AWS::StackName}-UserPoolId'

  UserPoolClientId:
    Description: Cognito Web Client ID
    Value: !Ref FixyachipsUserPoolClient
