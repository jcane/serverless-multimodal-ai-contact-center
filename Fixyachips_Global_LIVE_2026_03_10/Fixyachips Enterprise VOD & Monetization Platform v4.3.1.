    DependsOn: StripeWebhookWorkerLogGroup
    Properties:
      FunctionName: !Sub 'FixyachipsStripeWebhook-${AWS::StackName}'
      Description: Stripe webhook processor with HMAC signature verification
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt FixyachipsMasterRole.Arn
      Timeout: 29
      MemorySize: 256
      ReservedConcurrentExecutions: 50
      TracingConfig:
        Mode: Active
      DeadLetterConfig:
        TargetArn: !GetAtt StripeWebhookDLQ.Arn
      Environment:
        Variables:
          SECRET_ARN: !Ref StripeApiSecret
          TABLE_NAME: !Ref StudentTable
          ENVIRONMENT: !Ref Environment
      Code:
        ZipFile: |
          import json
          import boto3
          import os
          import logging
          import hmac
          import hashlib
          import time
          import uuid
          from datetime import datetime, timezone
          from botocore.exceptions import ClientError

          logger = logging.getLogger()
          logger.setLevel(logging.INFO)

          _secrets_cache = None
          _secrets_cache_time = 0
          SECRETS_TTL = 300  # Cache secrets for 5 minutes


          def get_stripe_secrets():
              """Cached secrets retrieval to reduce Secrets Manager API calls."""
              global _secrets_cache, _secrets_cache_time
              current_time = time.time()
              if _secrets_cache and (current_time - _secrets_cache_time) < SECRETS_TTL:
                  return _secrets_cache
              client = boto3.client('secretsmanager')
              response = client.get_secret_value(SecretId=os.environ['SECRET_ARN'])
              _secrets_cache = json.loads(response['SecretString'])
              _secrets_cache_time = current_time
              return _secrets_cache


          def verify_stripe_signature(payload_body, sig_header, webhook_secret):
              """
              Verify Stripe webhook HMAC-SHA256 signature.
              Implements replay attack protection with 5-minute tolerance.
              """
              try:
                  timestamp = None
                  signatures = []
                  for element in sig_header.split(','):
                      key, value = element.split('=', 1)
                      if key == 't':
                          timestamp = int(value)
                      elif key == 'v1':
                          signatures.append(value)

                  if not timestamp or not signatures:
                      logger.error('Missing timestamp or v1 signatures')
                      return False

                  # Replay attack protection
                  age_seconds = abs(int(time.time()) - timestamp)
                  if age_seconds > 300:
                      logger.error('Webhook too old: %d seconds', age_seconds)
                      return False

                  signed_payload = f'{timestamp}.{payload_body}'
                  expected = hmac.new(
                      webhook_secret.encode('utf-8'),
                      signed_payload.encode('utf-8'),
                      hashlib.sha256
                  ).hexdigest()

                  return any(hmac.compare_digest(expected, sig) for sig in signatures)
              except Exception as e:
                  logger.error('Signature verification exception: %s', str(e))
                  return False


          def lambda_handler(event, context):
              try:
                  payload_body = event.get('body', '') or ''
                  if not payload_body:
                      return {'statusCode': 400, 'body': json.dumps({'error': 'Empty body'})}

                  headers = event.get('headers', {}) or {}
                  sig_header = (
                      headers.get('Stripe-Signature') or
                      headers.get('stripe-signature') or ''
                  )

                  if not sig_header:
                      logger.error('Missing Stripe-Signature header - possible replay attack')
                      return {'statusCode': 400, 'body': json.dumps({'error': 'Missing signature'})}

                  secrets = get_stripe_secrets()
                  webhook_secret = secrets.get('webhook_secret', '')

                  if not webhook_secret or 'REPLACE' in webhook_secret:
                      logger.error('Webhook secret not configured')
                      return {'statusCode': 500, 'body': json.dumps({'error': 'Config error'})}

                  if not verify_stripe_signature(payload_body, sig_header, webhook_secret):
                      logger.error('SECURITY: Stripe signature verification FAILED')
                      return {'statusCode': 403, 'body': json.dumps({'error': 'Invalid signature'})}

                  event_dict = json.loads(payload_body)
                  event_type = event_dict.get('type')
                  stripe_event_id = event_dict.get('id', 'unknown')

                  logger.info('Verified Stripe event: %s (id: %s)', event_type, stripe_event_id)

                  if event_type == 'checkout.session.completed':
                      session = event_dict.get('data', {}).get('object', {})
                      customer_email = session.get('customer_details', {}).get('email', '').lower().strip()
                      payment_status = session.get('payment_status')

                      if not customer_email or payment_status != 'paid':
                          logger.warning('Invalid session state: email=%s status=%s',
                                        bool(customer_email), payment_status)
                          return {'statusCode': 200, 'body': json.dumps({'received': True})}

                      # CRITICAL FIX: Use same uuid5 derivation as SignupWorker
                      student_id = str(uuid.uuid5(uuid.NAMESPACE_URL, 'fixyachips:' + customer_email))

                      table = boto3.resource('dynamodb').Table(os.environ['TABLE_NAME'])
                      try:
                          table.update_item(
                              Key={'StudentID': student_id},
                              UpdateExpression=(
                                  'SET #s = :status, Entitlement = :ent, '
                                  'Email = :email, StripeEventId = :eid, UpdatedAt = :ts'
                              ),
                              ExpressionAttributeNames={'#s': 'Status'},
                              ExpressionAttributeValues={
                                  ':status': 'ACTIVE_SUBSCRIBER',
                                  ':ent': 'VOD_FULL_ACCESS',
                                  ':email': customer_email,
                                  ':eid': stripe_event_id,
                                  ':ts': datetime.now(timezone.utc).isoformat()
                              }
                          )
                          logger.info('Provisioned VOD access: %s (event: %s)',
                                      student_id, stripe_event_id)
                      except ClientError as e:
                          logger.error('DynamoDB error: %s', e.response['Error']['Code'])
                          return {'statusCode': 500, 'body': json.dumps({'error': 'DB error'})}

                  return {'statusCode': 200, 'body': json.dumps({'received': True})}

              except json.JSONDecodeError:
                  logger.error('Invalid JSON in webhook body')
                  return {'statusCode': 400, 'body': json.dumps({'error': 'Invalid JSON'})}
              except Exception as err:
                  logger.error('Webhook failed: %s', str(err), exc_info=True)
                  return {'statusCode': 500, 'body': json.dumps({'error': 'Internal error'})}

