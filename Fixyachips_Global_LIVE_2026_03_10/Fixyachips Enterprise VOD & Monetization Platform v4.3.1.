          );
          if (!isFile) {
            if (uri.endsWith('/')) {
              request.uri = uri + 'index.html';
            } else if (!uri.includes('.')) {
              request.uri = uri + '.html';
            }
          }
          return request;
        }

  # ----------------------------------------------------------
  # S3 - ACCESS LOGS BUCKET
  # ----------------------------------------------------------
  AccessLogsBucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      BucketName: !Sub 'fixyachips-logs-${AWS::AccountId}'
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      OwnershipControls:
        Rules:
          - ObjectOwnership: BucketOwnerPreferred
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      LifecycleConfiguration:
        Rules:
          - Id: LogRetention90Days
            Status: Enabled
            ExpirationInDays: 90
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment

  AccessLogsBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref AccessLogsBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: S3LogDelivery
            Effect: Allow
            Principal:
              Service: logging.s3.amazonaws.com
            Action: s3:PutObject
            Resource: !Sub 'arn:aws:s3:::${AccessLogsBucket}/*'
            Condition:
              ArnLike:
                aws:SourceArn: !Sub 'arn:aws:s3:::${StreamingVideoBucket}'
              StringEquals:
                aws:SourceAccount: !Ref AWS::AccountId
          - Sid: DenyNonHTTPS
            Effect: Deny
            Principal: '*'
            Action: 's3:*'
            Resource:
              - !Sub 'arn:aws:s3:::${AccessLogsBucket}'
              - !Sub 'arn:aws:s3:::${AccessLogsBucket}/*'
            Condition:
              Bool:
                aws:SecureTransport: 'false'

  # ----------------------------------------------------------
  # S3 - CONTENT AND VIDEO BUCKET
  # ----------------------------------------------------------
  StreamingVideoBucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      BucketName: !Sub 'fixyachips-platform-${AWS::AccountId}'
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
            BucketKeyEnabled: true
      VersioningConfiguration:
        Status: Enabled
      CorsConfiguration:
        CorsRules:
          - AllowedHeaders:
              - Authorization
              - Content-Type
            AllowedMethods:
              - GET
            AllowedOrigins:
              - 'https://fixyachips.com'
              - 'https://www.fixyachips.com'
            MaxAge: 3600
      LoggingConfiguration:
        DestinationBucketName: !Ref AccessLogsBucket
        LogFilePrefix: s3-access/
      LifecycleConfiguration:
        Rules:
          - Id: IntelligentTieringAfter90Days
            Status: Enabled
            Transitions:
              - TransitionInDays: 90
                StorageClass: INTELLIGENT_TIERING
            NoncurrentVersionTransitions:
              - TransitionInDays: 30
                StorageClass: STANDARD_IA
            NoncurrentVersionExpirationInDays: 180
          - Id: CleanupIncompleteMultiparts
            Status: Enabled
            AbortIncompleteMultipartUpload:
              DaysAfterInitiation: 7
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment

  BucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref StreamingVideoBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: AllowCloudFrontOACAccess
            Effect: Allow
            Principal:
              Service: cloudfront.amazonaws.com
            Action: s3:GetObject
            Resource: !Sub 'arn:aws:s3:::${StreamingVideoBucket}/*'
            Condition:
              StringEquals:
                AWS:SourceArn: !Sub 'arn:aws:cloudfront::${AWS::AccountId}:distribution/${WebsiteDistribution}'
          - Sid: DenyNonHTTPS
            Effect: Deny
            Principal: '*'
            Action: 's3:*'
            Resource:
              - !Sub 'arn:aws:s3:::${StreamingVideoBucket}'
              - !Sub 'arn:aws:s3:::${StreamingVideoBucket}/*'
            Condition:
              Bool:
                aws:SecureTransport: 'false'
          - Sid: AllowLambdaAccess
            Effect: Allow
            Principal:
              AWS: !GetAtt FixyachipsMasterRole.Arn
            Action:
              - s3:GetObject
              - s3:PutObject
              - s3:DeleteObject
            Resource: !Sub 'arn:aws:s3:::${StreamingVideoBucket}/*'
            Condition:
              Bool:
                aws:SecureTransport: 'true'

  # ----------------------------------------------------------
  # CLOUDFRONT SECURITY RESPONSE HEADERS POLICY
  # ----------------------------------------------------------
  SecurityHeadersPolicy:
    Type: AWS::CloudFront::ResponseHeadersPolicy
    Properties:
      ResponseHeadersPolicyConfig:
        Name: !Sub 'FixyachipsSecurityHeaders-${AWS::StackName}'
        Comment: Security headers for all CloudFront responses
        SecurityHeadersConfig:
          StrictTransportSecurity:
            AccessControlMaxAgeSec: 63072000
            IncludeSubdomains: true
            Preload: true
            Override: true
          ContentTypeOptions:
            Override: true
          FrameOptions:
            FrameOption: DENY
            Override: true
          XSSProtection:
            Protection: true
            ModeBlock: true
            Override: true
          ReferrerPolicy:
            ReferrerPolicy: strict-origin-when-cross-origin
            Override: true
          ContentSecurityPolicy:
            ContentSecurityPolicy: "default-src 'self' https://fixyachips.com https://*.fixyachips.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.fixyachips.com https://*.amazonaws.com; media-src 'self' https://*.fixyachips.com https://*.cloudfront.net; connect-src 'self' https://*.amazonaws.com https://*.fixyachips.com; frame-ancestors 'none'; upgrade-insecure-requests;"
            Override: true
        CustomHeadersConfig:
          Items:
            - Header: Permissions-Policy
              Value: 'camera=(), microphone=(), geolocation=(self), payment=(self)'
              Override: true

  # ----------------------------------------------------------
  # CLOUDFRONT DISTRIBUTION
  # ----------------------------------------------------------
  WebsiteDistribution:
    Type: AWS::CloudFront::Distribution
    Properties:
      DistributionConfig:
        Enabled: true
        Comment: !Sub 'Fixyachips Global Platform ${Environment}'
        PriceClass: PriceClass_All
        DefaultRootObject: index.html
        HttpVersion: http2and3
        IPV6Enabled: true
        WebACLId: !GetAtt WebBodyguard.Arn
        Aliases:
          - fixyachips.com
          - www.fixyachips.com
        ViewerCertificate:
          AcmCertificateArn: !Ref CertificateArn
          SslSupportMethod: sni-only
          MinimumProtocolVersion: TLSv1.2_2021
        Origins:
          - Id: S3Origin
            DomainName: !GetAtt StreamingVideoBucket.RegionalDomainName
            S3OriginConfig:
              OriginAccessIdentity: ''
            OriginAccessControlId: !GetAtt EmpireOAC.Id
            OriginShield:
              Enabled: true
              OriginShieldRegion: us-east-1
        DefaultCacheBehavior:
          TargetOriginId: S3Origin
          ViewerProtocolPolicy: redirect-to-https
          Compress: true
          AllowedMethods:
            - GET
            - HEAD
            - OPTIONS
          CachedMethods:
            - GET
            - HEAD
          ResponseHeadersPolicyId: !Ref SecurityHeadersPolicy
          ForwardedValues:
            QueryString: false
            Cookies:
              Forward: none
          FunctionAssociations:
            - EventType: viewer-request
              FunctionARN: !GetAtt WebsiteRouterFunction.FunctionMetadata.FunctionARN
        CustomErrorResponses:
          - ErrorCode: 403
            ResponseCode: 200
            ResponsePagePath: /error/403.html
            ErrorCachingMinTTL: 10
          - ErrorCode: 404
            ResponseCode: 200
            ResponsePagePath: /error/404.html
            ErrorCachingMinTTL: 10
          - ErrorCode: 500
            ResponseCode: 200
            ResponsePagePath: /error/500.html
            ErrorCachingMinTTL: 0
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment

