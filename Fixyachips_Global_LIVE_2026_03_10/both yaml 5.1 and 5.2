# Replace QueueWorker block
# ============================================================

  QueueWorker:
    Type: 'AWS::Lambda::Function'
    Properties:
      FunctionName: !Sub 'FixyachipsQueueWorker-${AWS::StackName}'
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt QueueWorkerRole.Arn
      Timeout: 30
      MemorySize: 512
      ReservedConcurrentExecutions: 500
      TracingConfig:
        Mode: Active
      Environment:
        Variables:
          TABLE_NAME: !Ref StudentTable
          UNIQ_TABLE: !Ref EmailUniquenessTable
      Code:
        ZipFile: |
          # ... same Python code as v5.1.1 ...

  QueueWorkerVersion:
    Type: 'AWS::Lambda::Version'
    Properties:
      FunctionName: !Ref QueueWorker

  QueueWorkerProvisionedAlias:
    Type: 'AWS::Lambda::Alias'
    Properties:
      FunctionName: !Ref QueueWorker
      FunctionVersion: !GetAtt QueueWorkerVersion.Version
      Name: live
      ProvisionedConcurrencyConfig:
        ProvisionedConcurrentExecutions: 50


# ============================================================
# DELTA #4: NotificationWorker concurrency
# Replace NotificationWorker block
# ============================================================

  NotificationWorker:
    Type: 'AWS::Lambda::Function'
    Properties:
      FunctionName: !Sub 'FixyachipsNotificationWorker-${AWS::StackName}'
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt NotificationWorkerRole.Arn
      Timeout: 15
      MemorySize: 256
      ReservedConcurrentExecutions: 100
      TracingConfig:
        Mode: Active
      Environment:
        Variables:
          ADMIN_EMAIL: !Ref AdminEmail
      Code:
        ZipFile: |
          # ... same Python code as v5.1.1 ...


# ============================================================
# DELTA #5: API Stage throttle
# Replace ApiStage.MethodSettings
# ============================================================

#      MethodSettings:
#        - ResourcePath: '/*'
#          HttpMethod: '*'
#          ThrottlingRateLimit: 5000
#          ThrottlingBurstLimit: 10000
#          MetricsEnabled: true
#          DataTraceEnabled: false
#          LoggingLevel: ERROR


# ============================================================
# DELTA #6: Lambda concurrency saturation alarm
# ADD after existing alarms
# ============================================================

  QueueWorkerConcurrencyAlarm:
    Type: 'AWS::CloudWatch::Alarm'
    Properties:
      AlarmName:
        !Sub 'Fixyachips-QueueWorker-NearMax-${AWS::StackName}'
      AlarmDescription: >
        QueueWorker is approaching reserved concurrency limit
      MetricName: ConcurrentExecutions
