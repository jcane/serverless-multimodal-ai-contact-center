  # ========================================================================
  # EMAIL WORKER LAMBDA — drains SQS, sends SES, retries via DLQ
  # ========================================================================
  EmailWorker:
    Type: 'AWS::Lambda::Function'
    Properties:
      FunctionName: !Sub 'FixyachipsEmailWorker-${AWS::StackName}'
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt EmailWorkerRole.Arn
      Timeout: 30
      MemorySize: 256
      ReservedConcurrentExecutions: 50
      Environment:
        Variables:
          ADMIN_EMAIL: !Ref AdminEmail
          FROM_EMAIL: !Ref AdminEmail
      Code:
        ZipFile: |
          import json, boto3, os
          ses = boto3.client('ses')
          ADMIN_EMAIL = os.environ['ADMIN_EMAIL']
          FROM_EMAIL = os.environ['FROM_EMAIL']

          def send_welcome(to_email, name):
              ses.send_email(
                  Source=FROM_EMAIL,
                  Destination={'ToAddresses': [to_email]},
                  Message={
                      'Subject': {'Data': 'Welcome to the No-Drill Revolution - Fixyachips Academy'},
                      'Body': {'Text': {'Data':
                          'Hello ' + name + ',\n\n'
                          'You are now on the waitlist for Fixyachips Global Academy.\n\n'
                          'Joshua Cane\nFounder, Fixyachips Global Academy'}}
                  }
              )

          def send_admin(name, email, industry, ip, country):
              ses.send_email(
                  Source=FROM_EMAIL,
                  Destination={'ToAddresses': [ADMIN_EMAIL]},
                  Message={
                      'Subject': {'Data': 'New Waitlist Signup: ' + name},
                      'Body': {'Text': {'Data':
                          'New signup:\nName: ' + name +
                          '\nEmail: ' + email +
                          '\nIndustry: ' + industry +
                          '\nCountry: ' + country +
                          '\nIP: ' + ip}}
                  }
              )

          def lambda_handler(event, context):
              failures = []
              for record in event.get('Records', []):
                  try:
                      msg = json.loads(record['body'])
                      t = msg.get('type')
                      if t == 'welcome':
                          send_welcome(msg['to'], msg['name'])
                      elif t == 'admin_notify':
                          send_admin(msg['name'], msg['email'], msg['industry'],
                                     msg['ip'], msg.get('country', 'XX'))
                  except Exception as e:
                      print('Email send error: ' + str(e))
                      failures.append({'itemIdentifier': record['messageId']})
              return {'batchItemFailures': failures}

