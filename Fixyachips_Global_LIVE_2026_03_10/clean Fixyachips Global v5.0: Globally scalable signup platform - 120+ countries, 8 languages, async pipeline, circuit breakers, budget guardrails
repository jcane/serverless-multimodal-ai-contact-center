        Type: AWS_PROXY
        Uri: !Sub 'arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${SignupWorker.Arn}/invocations'

  # OPTIONS via MOCK = no Lambda cost on preflight
  ApiOptionsMethod:
    Type: 'AWS::ApiGateway::Method'
    Properties:
      AuthorizationType: NONE
      HttpMethod: OPTIONS
      ResourceId: !Ref ApiResource
      RestApiId: !Ref SignupAPI
      Integration:
        Type: MOCK
        RequestTemplates:
          application/json: '{"statusCode": 200}'
        IntegrationResponses:
          - StatusCode: 200
            ResponseParameters:
              method.response.header.Access-Control-Allow-Headers: "'Content-Type'"
              method.response.header.Access-Control-Allow-Methods: "'POST,OPTIONS'"
              method.response.header.Access-Control-Allow-Origin: !Sub "'https://${DomainName}'"
              method.response.header.Access-Control-Max-Age: "'3600'"
      MethodResponses:
        - StatusCode: 200
          ResponseParameters:
            method.response.header.Access-Control-Allow-Headers: true
            method.response.header.Access-Control-Allow-Methods: true
            method.response.header.Access-Control-Allow-Origin: true
            method.response.header.Access-Control-Max-Age: true

  ApiDeployment:
    Type: 'AWS::ApiGateway::Deployment'
    DependsOn:
      - ApiMethod
      - ApiOptionsMethod
    Properties:
      RestApiId: !Ref SignupAPI

  ApiStage:
    Type: 'AWS::ApiGateway::Stage'
    Properties:
      StageName: prod
      RestApiId: !Ref SignupAPI
      DeploymentId: !Ref ApiDeployment
      MethodSettings:
        - ResourcePath: '/*'
          HttpMethod: '*'
          # Generous account-stage caps; per-IP enforced by WAF + Lambda
          ThrottlingBurstLimit: 2000
          ThrottlingRateLimit: 1000
          LoggingLevel: ERROR
          DataTraceEnabled: false
          MetricsEnabled: true

  LambdaPermission:
    Type: 'AWS::Lambda::Permission'
    Properties:
      Action: 'lambda:InvokeFunction'
      FunctionName: !Ref SignupWorker
      Principal: apigateway.amazonaws.com
      SourceArn: !Sub 'arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${SignupAPI}/*'

  # ========================================================================
  # COGNITO — PreSignUp Lambda blocks bot-pattern emails
  # ========================================================================
  CognitoPreSignUpFunction:
    Type: 'AWS::Lambda::Function'
    Properties:
      FunctionName: !Sub 'FixyachipsCognitoPreSignUp-${AWS::StackName}'
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt CognitoTriggerRole.Arn
      Timeout: 5
      MemorySize: 128
      ReservedConcurrentExecutions: 100
      Code:
        ZipFile: |
          import re
          DISPOSABLE_DOMAINS = {
              'mailinator.com', 'guerrillamail.com', 'tempmail.com',
              '10minutemail.com', 'throwaway.email', 'yopmail.com',
              'trashmail.com', 'sharklasers.com', 'getnada.com'
          }
          PLUS_BOT_RE = re.compile(r'\+\d{4,}@')
          def lambda_handler(event, context):
              email = (event.get('request', {}).get('userAttributes', {}).get('email') or '').lower()
              if not email:
                  raise Exception('Email required')
              domain = email.split('@')[-1] if '@' in email else ''
              if domain in DISPOSABLE_DOMAINS:
                  raise Exception('Please use a permanent email address')
              if PLUS_BOT_RE.search(email):
                  raise Exception('Invalid email format')
              return event

  CognitoPreSignUpLogGroup:
    Type: 'AWS::Logs::LogGroup'
    Properties:
      LogGroupName: !Sub '/aws/lambda/FixyachipsCognitoPreSignUp-${AWS::StackName}'
      RetentionInDays: 30

  CognitoInvokePermission:
    Type: 'AWS::Lambda::Permission'
    Properties:
      Action: 'lambda:InvokeFunction'
      FunctionName: !Ref CognitoPreSignUpFunction
      Principal: cognito-idp.amazonaws.com
      SourceArn: !GetAtt FixyachipsUserPool.Arn

  FixyachipsUserPool:
    Type: 'AWS::Cognito::UserPool'
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      UserPoolName: !Sub 'Fixyachips_Global_Users-${AWS::StackName}'
      UsernameAttributes: [email]
      AutoVerifiedAttributes: [email]
      MfaConfiguration: OPTIONAL
      EnabledMfas:
        - SOFTWARE_TOKEN_MFA
      Policies:
        PasswordPolicy:
          MinimumLength: 10
          RequireLowercase: true
          RequireNumbers: true
          RequireSymbols: true
          RequireUppercase: true
          TemporaryPasswordValidityDays: 7
      AccountRecoverySetting:
        RecoveryMechanisms:
          - Name: verified_email
            Priority: 1
      UserPoolAddOns:
        AdvancedSecurityMode: ENFORCED
      LambdaConfig:
        PreSignUp: !GetAtt CognitoPreSignUpFunction.Arn
      Schema:
        - Name: email
          AttributeDataType: String
          Mutable: true
          Required: true
        - Name: veteran_status
          AttributeDataType: String
          Mutable: true
        - Name: industry_segment
          AttributeDataType: String
