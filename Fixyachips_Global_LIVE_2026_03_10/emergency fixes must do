  WebsiteDistribution:
    Type: 'AWS::CloudFront::Distribution'
    Properties:
      DistributionConfig:
        Enabled: true
        PriceClass: PriceClass_All
        DefaultRootObject: index.html
        WebACLId: !GetAtt WebBodyguard.Arn
        Aliases:
          - fixyachips.com
          - www.fixyachips.com
        ViewerCertificate:
          AcmCertificateArn: !Ref CertificateArn
          SslSupportMethod: sni-only
          MinimumProtocolVersion: TLSv1.2_2021
        Origins:
          - Id: S3Origin
            DomainName: !GetAtt StreamingVideoBucket.RegionalDomainName
            S3OriginConfig:
              OriginAccessIdentity: ""
            OriginAccessControlId: !GetAtt EmpireOAC.Id
            OriginShield:
              Enabled: true
              OriginShieldRegion: us-east-1
        DefaultCacheBehavior:
          TargetOriginId: S3Origin
          ViewerProtocolPolicy: redirect-to-https
          Compress: true
          ForwardedValues:
            QueryString: false
          FunctionAssociations:
            - EventType: viewer-request
              FunctionARN: !GetAtt WebsiteRouterFunction.FunctionMetadata.FunctionARN

  StudentTable:
    Type: 'AWS::DynamoDB::Table'
    DeletionPolicy: Retain
    Properties:
      TableName: !Sub 'FixyachipsStudents-${AWS::StackName}'
      AttributeDefinitions:
        - AttributeName: StudentID
          AttributeType: S
      KeySchema:
        - AttributeName: StudentID
          KeyType: HASH
      BillingMode: PAY_PER_REQUEST

  FixyachipsMasterRole:
    Type: 'AWS::IAM::Role'
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal: { Service: [lambda.amazonaws.com] }
            Action: ['sts:AssumeRole']
      ManagedPolicyArns:
        - 'arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole'
      Policies:
        - PolicyName: FixyachipsAIPowerhouse
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - 's3:GetObject'
                  - 's3:PutObject'
                  - 's3:DeleteObject'
                  - 's3:ListBucket'
                Resource:
                  - !Sub 'arn:aws:s3:::${StreamingVideoBucket}'
                  - !Sub 'arn:aws:s3:::${StreamingVideoBucket}/*'
              - Effect: Allow
                Action:
                  - 'dynamodb:GetItem'
                  - 'dynamodb:PutItem'
                  - 'dynamodb:UpdateItem'
                  - 'dynamodb:DeleteItem'
                  - 'dynamodb:Query'
                  - 'dynamodb:Scan'
                Resource: !GetAtt StudentTable.Arn
              - Effect: Allow
                Action:
                  - 'ses:SendEmail'
                  - 'bedrock:*'
                  - 'transcribe:*'
                  - 'translate:*'
                  - 'polly:*'
                Resource: '*'

  SignupWorker:
    Type: 'AWS::Lambda::Function'
    Properties:
      FunctionName: !Sub 'FixyachipsSignupWorker-${AWS::StackName}'
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt FixyachipsMasterRole.Arn
      Timeout: 30
      Environment:
        Variables:
          TABLE_NAME: !Ref StudentTable
          ADMIN_EMAIL: !Ref AdminEmail
      Code:
        ZipFile: |
          import json, boto3, uuid, os
          dynamodb = boto3.resource('dynamodb')
          ses = boto3.client('ses')
          table = dynamodb.Table(os.environ['TABLE_NAME'])

          def lambda_handler(event, context):
              if event.get('httpMethod') == 'OPTIONS':
                  return {
                      'statusCode': 200,
                      'headers': {
                          'Access-Control-Allow-Origin': 'https://fixyachips.com',
                          'Access-Control-Allow-Headers': 'Content-Type',
                          'Access-Control-Allow-Methods': 'POST, OPTIONS'
                      },
                      'body': ''
                  }
              try:
                  body = json.loads(event['body'])
                  email = body.get('email', '').strip().lower()
                  name = body.get('name', '').strip()
                  if not email or not name:
                      return {
                          'statusCode': 400,
                          'headers': {'Access-Control-Allow-Origin': 'https://fixyachips.com'},
                          'body': json.dumps({'error': 'Name and email are required'})
                      }
                  table.put_item(Item={
                      'StudentID': str(uuid.uuid4()),
                      'Name': name,
                      'Email': email,
                      'Status': 'WAITLIST',
                      'Source': body.get('source', 'website'),
                      'Industry': body.get('industry', 'unknown')
                  })
                  ses.send_email(
                      Source=os.environ['ADMIN_EMAIL'],
                      Destination={'ToAddresses': [email]},
                      Message={
                          'Subject': {'Data': 'Welcome to the No-Drill Revolution - Fixyachips Academy'},
                          'Body': {'Text': {'Data': 'Hello ' + name + ',\n\nYou are now on the waitlist for Fixyachips Global Academy.\n\nWe will notify you the moment enrollment opens.\n\nJoshua Cane\nFounder, Fixyachips Global Academy'}}
                      }
                  )
                  ses.send_email(
                      Source=os.environ['ADMIN_EMAIL'],
                      Destination={'ToAddresses': [os.environ['ADMIN_EMAIL']]},
                      Message={
                          'Subject': {'Data': f'New Waitlist Signup: {name}'},
                          'Body': {'Text': {'Data': f'New signup:\nName: {name}\nEmail: {email}\nIndustry: {body.get("industry", "unknown")}'}}
                      }
                  )
                  return {
                      'statusCode': 200,
                      'headers': {
                          'Access-Control-Allow-Origin': 'https://fixyachips.com',
                          'Content-Type': 'application/json'
                      },
                      'body': json.dumps({'status': 'success', 'message': 'Welcome to the revolution!'})
                  }
              except Exception as e:
                  print(f"ERROR: {str(e)}")
                  return {
                      'statusCode': 500,
                      'headers': {'Access-Control-Allow-Origin': 'https://fixyachips.com'},
                      'body': json.dumps({'error': 'Signup failed. Please try again.'})
                  }

