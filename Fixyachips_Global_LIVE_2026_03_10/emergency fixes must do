  # ------------------------------------------------------------
  # CLOUDFRONT DISTRIBUTION
  # Global delivery, TLS 1.2+, WAF attached
  # ADDED: HTTP/3, IPv6, logging, security headers policy
  # ------------------------------------------------------------

  # Security headers delivered on every response at edge
  SecurityHeadersPolicy:
    Type: 'AWS::CloudFront::ResponseHeadersPolicy'
    Properties:
      ResponseHeadersPolicyConfig:
        Name: !Sub 'FixyachipsSecurityHeaders-${AWS::StackName}'
        Comment: 'Security headers on all CloudFront responses — zero Lambda cost'
        SecurityHeadersConfig:
          StrictTransportSecurity:
            AccessControlMaxAgeSec: 63072000
            IncludeSubdomains: true
            Preload: true
            Override: true
          ContentTypeOptions:
            Override: true
          FrameOptions:
            FrameOption: DENY
            Override: true
          XSSProtection:
            Protection: true
            ModeBlock: true
            Override: true
          ReferrerPolicy:
            ReferrerPolicy: strict-origin-when-cross-origin
            Override: true
          ContentSecurityPolicy:
