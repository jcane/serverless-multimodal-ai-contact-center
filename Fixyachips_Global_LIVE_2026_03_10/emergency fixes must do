      Name: !Sub '${AWS::StackName}-DLQUrl'

  AlertTopicArn:
    Description: 'SNS Alert Topic ARN'
    Value: !Ref AlertTopic
    Export:
      Name: !Sub '${AWS::StackName}-AlertTopicArn'

  StudentTableName:
    Description: 'DynamoDB waitlist table name'
    Value: !Ref StudentTable
    Export:
      Name: !Sub '${AWS::StackName}-StudentTable'
