      OKActions:
        - !Ref AlertNotificationTopic

  CheckoutWorkerDLQAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub 'VODPlatform-CheckoutDLQ-${AWS::StackName}'
      AlarmDescription: CRITICAL Failed Stripe checkout session creations in DLQ
      MetricName: ApproximateNumberOfMessagesVisible
      Namespace: AWS/SQS
      Statistic: Sum
      Period: 60
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      Dimensions:
        - Name: QueueName
          Value: !GetAtt CheckoutWorkerDLQ.QueueName
      AlarmActions:
        - !Ref AlertNotificationTopic
      OKActions:
        - !Ref AlertNotificationTopic

  ApiGateway5xxAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub 'VODPlatform-API-5xxErrors-${AWS::StackName}'
      AlarmDescription: API Gateway returning server-side 5xx errors
      MetricName: 5XXError
      Namespace: AWS/ApiGateway
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 2
      DatapointsToAlarm: 2
      Threshold: 5
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      Dimensions:
        - Name: ApiName
          Value: !Sub 'VODPlatformAPI-${AWS::StackName}'
        - Name: Stage
          Value: !Ref Environment
      AlarmActions:
        - !Ref AlertNotificationTopic
      OKActions:
        - !Ref AlertNotificationTopic

  StripeWebhookThrottleAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub 'VODPlatform-StripeWebhook-Throttles-${AWS::StackName}'
      AlarmDescription: Stripe webhook Lambda being throttled — increase concurrency
      MetricName: Throttles
      Namespace: AWS/Lambda
      Statistic: Sum
      Period: 60
      EvaluationPeriods: 1
      Threshold: 1
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      Dimensions:
        - Name: FunctionName
          Value: !Ref StripeWebhookWorker
      AlarmActions:
        - !Ref AlertNotificationTopic
      OKActions:
        - !Ref AlertNotificationTopic

# ============================================================
# OUTPUTS
# ============================================================
Outputs:

  # Marketplace display outputs
  MarketplaceProductVersion:
    Description: Deployed product version
    Value: '4.5.0'

  EULAAcceptedAt:
    Description: Timestamp when EULA was accepted
    Value: !GetAtt EULAAcceptanceRecord.AcceptedAt

  # Platform endpoints
  CloudFrontDistributionId:
    Description: CloudFront Distribution ID
    Value: !Ref WebsiteDistribution
    Export:
      Name: !Sub '${AWS::StackName}-CloudFrontDistributionId'

  CloudFrontDomainName:
    Description: CloudFront distribution domain — use for DNS CNAME
    Value: !GetAtt WebsiteDistribution.DomainName
    Export:
      Name: !Sub '${AWS::StackName}-CloudFrontDomain'

  ApiGatewayEndpoint:
    Description: REST API base URL
    Value: !Sub 'https://${PlatformApi}.execute-api.${AWS::Region}.amazonaws.com/${Environment}'
    Export:
      Name: !Sub '${AWS::StackName}-ApiEndpoint'

  SignupEndpointUrl:
    Description: POST /signup — accepts name + email, returns success
    Value: !Sub 'https://${PlatformApi}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/signup'
    Export:
      Name: !Sub '${AWS::StackName}-SignupEndpoint'

  CheckoutEndpointUrl:
    Description: POST /checkout — accepts email, returns Stripe session URL
    Value: !Sub 'https://${PlatformApi}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/checkout'
    Export:
      Name: !Sub '${AWS::StackName}-CheckoutEndpoint'

  StripeWebhookEndpointUrl:
    Description: POST /webhook/stripe — register this URL in Stripe Dashboard
    Value: !Sub 'https://${PlatformApi}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/webhook/stripe'
    Export:
      Name: !Sub '${AWS::StackName}-StripeWebhookEndpoint'

  # Data stores
  StudentTableName:
    Description: DynamoDB Students table name
    Value: !Ref StudentTable
    Export:
      Name: !Sub '${AWS::StackName}-StudentTable'

  ContentBucketName:
    Description: S3 content bucket — upload raw videos to raw/ prefix
    Value: !Ref StreamingVideoBucket
    Export:
      Name: !Sub '${AWS::StackName}-ContentBucket'

  # Secrets
  StripeSecretArn:
    Description: >-
      Secrets Manager ARN — update api_key, webhook_secret, and price_id values
      after deployment before processing payments
    Value: !Ref StripeApiSecret
    Export:
      Name: !Sub '${AWS::StackName}-StripeSecretArn'

  # Media processing
  MediaConvertQueueArn:
    Description: MediaConvert queue ARN
    Value: !GetAtt MediaConvertQueue.Arn
    Export:
      Name: !Sub '${AWS::StackName}-MediaConvertQueue'

  # CloudFront signed URL
  VODKeyGroupId:
    Description: CloudFront Key Group ID for signed VOD URLs
    Condition: HasPublicKey
    Value: !Ref VODKeyGroup
    Export:
      Name: !Sub '${AWS::StackName}-VODKeyGroupId'

  # DLQ URLs for operations
  StripeWebhookDLQUrl:
    Description: DLQ URL — monitor for failed Stripe webhook deliveries
    Value: !Ref StripeWebhookDLQ
    Export:
      Name: !Sub '${AWS::StackName}-StripeWebhookDLQ'

  SignupDLQUrl:
    Description: DLQ URL — monitor for failed signup processing
    Value: !Ref SignupDLQ
    Export:
      Name: !Sub '${AWS::StackName}-SignupDLQ'

  CheckoutWorkerDLQUrl:
    Description: DLQ URL — monitor for failed checkout session creations
    Value: !Ref CheckoutWorkerDLQ
    Export:
      Name: !Sub '${AWS::StackName}-CheckoutDLQ'

  # Layer
  StripePythonLayerArn:
    Description: Versioned ARN of the Stripe Python SDK Lambda Layer
    Value: !Ref StripePythonLayer
    Export:
      Name: !Sub '${AWS::StackName}-StripePythonLayerArn'
