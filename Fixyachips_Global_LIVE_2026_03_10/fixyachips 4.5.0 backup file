      RetentionInDays: !If [IsProduction, 30, 14]

  MediaConvertTriggerWorker:
    Type: AWS::Lambda::Function
    DependsOn: MediaConvertTriggerLogGroup
    Properties:
      FunctionName: !Sub 'VODPlatform-MCTrigger-${AWS::StackName}'
      Description: Auto-triggers MediaConvert HLS transcoding on S3 raw/ upload
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt MediaConvertTriggerRole.Arn
      Timeout: 60
      MemorySize: 256
      ReservedConcurrentExecutions: 20
      TracingConfig:
        Mode: Active
      Environment:
        Variables:
          MEDIACONVERT_ROLE: !GetAtt MediaConvertRole.Arn
          QUEUE_ARN: !GetAtt MediaConvertQueue.Arn
          OUTPUT_BUCKET: !Sub 'vod-platform-content-${AWS::AccountId}-${Environment}'
          AWS_REGION_NAME: !Ref AWS::Region
      Code:
        ZipFile: |
          import json, boto3, os, logging, urllib.parse

          logger = logging.getLogger()
          logger.setLevel(logging.INFO)

          _endpoint_cache = None

          def get_mediaconvert_endpoint():
              global _endpoint_cache
              if _endpoint_cache:
                  return _endpoint_cache
              client = boto3.client(
                  'mediaconvert',
                  region_name=os.environ.get('AWS_REGION_NAME', 'us-east-1')
              )
              _endpoint_cache = client.describe_endpoints()['Endpoints'][0]['Url']
              return _endpoint_cache

          def build_job_settings(bucket, key, output_bucket, output_prefix):
              """Build MediaConvert HLS 1080p + 720p job settings."""
              return {
                  'Inputs': [{
                      'FileInput': f's3://{bucket}/{key}',
                      'AudioSelectors': {
                          'Audio Selector 1': {'DefaultSelection': 'DEFAULT'}
                      }
                  }],
                  'OutputGroups': [{
                      'Name': 'HLS Output',
                      'OutputGroupSettings': {
                          'Type': 'HLS_GROUP_SETTINGS',
                          'HlsGroupSettings': {
                              'Destination': f's3://{output_bucket}/{output_prefix}',
                              'SegmentLength': 6,
                              'MinSegmentLength': 0
                          }
                      },
                      'Outputs': [
                          {
                              'NameModifier': '_1080p',
                              'VideoDescription': {
                                  'Width': 1920,
                                  'Height': 1080,
                                  'CodecSettings': {
                                      'Codec': 'H_264',
                                      'H264Settings': {
                                          'Bitrate': 5000000,
                                          'RateControlMode': 'CBR'
                                      }
                                  }
                              },
                              'AudioDescriptions': [{
                                  'CodecSettings': {
                                      'Codec': 'AAC',
                                      'AacSettings': {
                                          'Bitrate': 128000,
                                          'SampleRate': 48000
                                      }
                                  }
                              }],
                              'ContainerSettings': {'Container': 'M3U8'}
                          },
                          {
                              'NameModifier': '_720p',
                              'VideoDescription': {
                                  'Width': 1280,
                                  'Height': 720,
                                  'CodecSettings': {
                                      'Codec': 'H_264',
                                      'H264Settings': {
                                          'Bitrate': 2500000,
                                          'RateControlMode': 'CBR'
                                      }
                                  }
                              },
                              'AudioDescriptions': [{
                                  'CodecSettings': {
                                      'Codec': 'AAC',
                                      'AacSettings': {
                                          'Bitrate': 128000,
                                          'SampleRate': 48000
                                      }
                                  }
                              }],
                              'ContainerSettings': {'Container': 'M3U8'}
                          }
                      ]
                  }]
              }

          def lambda_handler(event, context):
              try:
                  for record in event.get('Records', []):
                      bucket = record['s3']['bucket']['name']
                      key = urllib.parse.unquote_plus(record['s3']['object']['key'])

                      if not key.startswith('raw/'):
                          logger.info('Skipping non-raw/ key: %s', key)
                          continue

                      output_prefix = key.replace('raw/', 'videos/', 1).rsplit('/', 1)[0] + '/'
                      output_bucket = os.environ['OUTPUT_BUCKET']

                      endpoint = get_mediaconvert_endpoint()
                      mc_client = boto3.client('mediaconvert', endpoint_url=endpoint)

                      job_settings = build_job_settings(bucket, key, output_bucket, output_prefix)
                      response = mc_client.create_job(
                          Role=os.environ['MEDIACONVERT_ROLE'],
                          Queue=os.environ['QUEUE_ARN'],
                          Settings=job_settings,
                          UserMetadata={
                              'source_bucket': bucket,
                              'source_key': key,
                              'output_prefix': output_prefix
                          }
                      )
                      logger.info('MediaConvert job created: %s', response['Job']['Id'])

                  return {'statusCode': 200, 'body': json.dumps('Jobs dispatched')}

              except Exception as e:
                  logger.error('MediaConvert trigger failed: %s', str(e), exc_info=True)
                  raise
