  # StripeWebhookWorker
  StripeWebhookWorkerLogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub '/aws/lambda/VODPlatform-StripeWebhook-${AWS::StackName}'
      RetentionInDays: !If [IsProduction, 90, 30]

  StripeWebhookWorker:
    Type: AWS::Lambda::Function
    DependsOn: StripeWebhookWorkerLogGroup
    Properties:
      FunctionName: !Sub 'VODPlatform-StripeWebhook-${AWS::StackName}'
      Description: Stripe webhook processor — HMAC-SHA256 signature verification, entitlement grant
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt StripeWebhookWorkerRole.Arn
      Timeout: 29
      MemorySize: 256
      ReservedConcurrentExecutions: 50
      TracingConfig:
        Mode: Active
      DeadLetterConfig:
        TargetArn: !GetAtt StripeWebhookDLQ.Arn
      Environment:
        Variables:
          SECRET_ARN: !Ref StripeApiSecret
          TABLE_NAME: !Ref StudentTable
          ENVIRONMENT: !Ref Environment
      Code:
        ZipFile: |
          import json, boto3, os, logging, hmac, hashlib, time, uuid
          from datetime import datetime, timezone
          from botocore.exceptions import ClientError

          logger = logging.getLogger()
          logger.setLevel(logging.INFO)

          _secret_cache = None
          _secret_ts = 0
          SECRET_TTL = 300
          TIMESTAMP_TOLERANCE_SECS = 300

          def get_secrets():
              global _secret_cache, _secret_ts
              now = time.time()
              if _secret_cache and (now - _secret_ts) < SECRET_TTL:
                  return _secret_cache
              client = boto3.client('secretsmanager')
              resp = client.get_secret_value(SecretId=os.environ['SECRET_ARN'])
              _secret_cache = json.loads(resp['SecretString'])
              _secret_ts = now
              return _secret_cache

          def verify_stripe_signature(body, sig_header, webhook_secret):
              """
              Verify Stripe webhook HMAC-SHA256 signature.
              Rejects requests older than TIMESTAMP_TOLERANCE_SECS.
              """
              try:
                  parts = dict(item.split('=', 1) for item in sig_header.split(',') if '=' in item)
                  ts = parts.get('t')
                  sigs = [v for k, v in parts.items() if k == 'v1']
                  if not ts or not sigs:
                      return False
                  try:
                      ts_int = int(ts)
                  except ValueError:
                      return False
                  age = abs(time.time() - ts_int)
                  if age > TIMESTAMP_TOLERANCE_SECS:
                      logger.warning('Stripe webhook timestamp too old: %d seconds', age)
                      return False
                  signed_payload = f'{ts}.{body}'
                  expected = hmac.new(
                      webhook_secret.encode(),
                      msg=signed_payload.encode(),
                      digestmod=hashlib.sha256
                  ).hexdigest()
                  return any(hmac.compare_digest(expected, s) for s in sigs)
              except Exception as e:
                  logger.error('Signature verification error: %s', str(e))
                  return False

          def lambda_handler(event, context):
              try:
                  raw_body = event.get('body') or ''
                  if not raw_body:
                      return {'statusCode': 400, 'body': json.dumps({'error': 'Empty body'})}

                  headers = event.get('headers') or {}
                  sig_header = (headers.get('Stripe-Signature') or
                                headers.get('stripe-signature') or '')
                  if not sig_header:
                      return {'statusCode': 400, 'body': json.dumps({'error': 'Missing signature'})}

                  secrets = get_secrets()
                  webhook_secret = secrets.get('webhook_secret', '')
                  if not webhook_secret or 'REPLACE' in webhook_secret:
                      logger.error('Stripe webhook_secret not configured')
                      return {'statusCode': 500, 'body': json.dumps({'error': 'Config error'})}

                  if not verify_stripe_signature(raw_body, sig_header, webhook_secret):
                      logger.error('SECURITY: Stripe signature verification FAILED')
                      return {'statusCode': 403, 'body': json.dumps({'error': 'Invalid signature'})}

                  event_data = json.loads(raw_body)
                  event_type = event_data.get('type')
                  event_id = event_data.get('id', 'unknown')
                  logger.info('Verified Stripe event: %s (id: %s)', event_type, event_id)

                  if event_type == 'checkout.session.completed':
                      session = event_data.get('data', {}).get('object', {})
                      customer_email = session.get('customer_details', {}).get('email', '').lower().strip()
                      payment_status = session.get('payment_status')
                      if not customer_email or payment_status != 'paid':
                          return {'statusCode': 200, 'body': json.dumps({'received': True})}

                      student_id = str(uuid.uuid5(uuid.NAMESPACE_URL, 'vod-platform:' + customer_email))
                      table = boto3.resource('dynamodb').Table(os.environ['TABLE_NAME'])
                      try:
                          table.update_item(
                              Key={'StudentID': student_id},
                              UpdateExpression=(
                                  'SET #s = :status, Entitlement = :ent, '
                                  'Email = :email, StripeEventId = :eid, UpdatedAt = :ts'
                              ),
                              ExpressionAttributeNames={'#s': 'Status'},
                              ExpressionAttributeValues={
                                  ':status': 'ACTIVE_SUBSCRIBER',
                                  ':ent': 'VOD_FULL_ACCESS',
                                  ':email': customer_email,
                                  ':eid': event_id,
                                  ':ts': datetime.now(timezone.utc).isoformat()
                              }
                          )
                      except ClientError as e:
                          logger.error('DynamoDB error: %s', e.response['Error']['Code'])
                          return {'statusCode': 500, 'body': json.dumps({'error': 'DB error'})}

                  return {'statusCode': 200, 'body': json.dumps({'received': True})}

              except json.JSONDecodeError:
                  return {'statusCode': 400, 'body': json.dumps({'error': 'Invalid JSON'})}
              except Exception as err:
                  logger.error('Webhook failed: %s', str(err), exc_info=True)
                  return {'statusCode': 500, 'body': json.dumps({'error': 'Internal error'})}
