  CheckoutWorker:
    Type: AWS::Lambda::Function
    DependsOn: CheckoutWorkerLogGroup
    Properties:
      FunctionName: !Sub 'VODPlatform-CheckoutWorker-${AWS::StackName}'
      Description: Creates Stripe Checkout Session — uses Stripe SDK layer and Secrets Manager
      Handler: index.lambda_handler
      Runtime: python3.12
      Role: !GetAtt CheckoutWorkerRole.Arn
      Timeout: 29
      MemorySize: 256
      ReservedConcurrentExecutions: 50
      TracingConfig:
        Mode: Active
      DeadLetterConfig:
        TargetArn: !GetAtt CheckoutWorkerDLQ.Arn
      Layers:
        - !Ref StripePythonLayer
      Environment:
        Variables:
          SECRET_ARN: !Ref StripeApiSecret
          ALLOWED_ORIGIN: !If
            - HasCertificate
            - 'https://fixyachips.com'
            - !Sub 'https://${WebsiteDistribution.DomainName}'
          SUCCESS_URL: !If
            - HasCertificate
            - 'https://fixyachips.com/success?session_id={CHECKOUT_SESSION_ID}'
            - !Sub 'https://${WebsiteDistribution.DomainName}/success?session_id={CHECKOUT_SESSION_ID}'
          CANCEL_URL: !If
            - HasCertificate
            - 'https://fixyachips.com/pricing'
            - !Sub 'https://${WebsiteDistribution.DomainName}/pricing'
          ENVIRONMENT: !Ref Environment
      Code:
        ZipFile: |
          import json, os, time, logging, boto3
          import stripe
          from botocore.exceptions import ClientError

          logger = logging.getLogger()
          logger.setLevel(logging.INFO)

          AO = os.environ.get('ALLOWED_ORIGIN', '')
          CORS_HEADERS = {
              'Access-Control-Allow-Origin': AO,
              'Access-Control-Allow-Headers': 'Content-Type',
              'Access-Control-Allow-Methods': 'POST, OPTIONS',
              'Vary': 'Origin',
              'X-Content-Type-Options': 'nosniff'
          }

          _stripe_key_cache = None
          _stripe_key_ts = 0
          _price_id_cache = None
          SECRET_TTL = 300

          def get_stripe_credentials():
              global _stripe_key_cache, _stripe_key_ts, _price_id_cache
              now = time.time()
              if _stripe_key_cache and (now - _stripe_key_ts) < SECRET_TTL:
                  return _stripe_key_cache, _price_id_cache
              client = boto3.client('secretsmanager')
              resp = client.get_secret_value(SecretId=os.environ['SECRET_ARN'])
              data = json.loads(resp['SecretString'])
              _stripe_key_cache = data.get('api_key', '')
              _price_id_cache = data.get('price_id', '')
              _stripe_key_ts = now
              return _stripe_key_cache, _price_id_cache

          def lambda_handler(event, context):
              if event.get('httpMethod') == 'OPTIONS':
                  return {'statusCode': 200, 'headers': CORS_HEADERS, 'body': ''}
              if event.get('httpMethod') != 'POST':
                  return {'statusCode': 405, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Method not allowed'})}
              try:
                  raw_body = event.get('body') or ''
                  if len(raw_body) > 4096:
                      return {'statusCode': 413, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': 'Request too large'})}
                  try:
                      body = json.loads(raw_body) if raw_body else {}
                  except json.JSONDecodeError:
                      return {'statusCode': 400, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': 'Invalid JSON'})}

                  customer_email = str(body.get('email', '')).strip().lower()

                  api_key, price_id = get_stripe_credentials()
                  if not api_key or 'REPLACE' in api_key:
                      logger.error('Stripe api_key not configured in Secrets Manager')
                      return {'statusCode': 500, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': 'Payment not configured'})}
                  if not price_id or 'REPLACE' in price_id:
                      logger.error('Stripe price_id not configured in Secrets Manager')
                      return {'statusCode': 500, 'headers': CORS_HEADERS,
                              'body': json.dumps({'error': 'Product not configured'})}

                  stripe.api_key = api_key
                  session_params = {
                      'payment_method_types': ['card'],
                      'line_items': [{'price': price_id, 'quantity': 1}],
                      'mode': 'payment',
                      'success_url': os.environ.get('SUCCESS_URL', ''),
                      'cancel_url': os.environ.get('CANCEL_URL', ''),
                      'metadata': {
                          'environment': os.environ.get('ENVIRONMENT', 'dev'),
                          'source': 'vod-platform-checkout'
                      }
                  }
                  if customer_email:
                      session_params['customer_email'] = customer_email

                  session = stripe.checkout.Session.create(**session_params)
                  logger.info('Stripe session created: %s email: %s',
                              session.id, customer_email or 'anon')
                  return {
                      'statusCode': 200,
                      'headers': CORS_HEADERS,
                      'body': json.dumps({'url': session.url, 'session_id': session.id})
                  }

              except ValueError as ve:
                  logger.error('Config error: %s', str(ve))
                  return {'statusCode': 500, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Payment configuration error'})}
              except stripe.error.CardError as e:
                  return {'statusCode': 402, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': e.user_message})}
              except stripe.error.InvalidRequestError as e:
                  logger.error('Stripe invalid request: %s', str(e))
                  return {'statusCode': 400, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Invalid payment request'})}
              except stripe.error.AuthenticationError:
                  logger.error('Stripe auth error — check api_key in Secrets Manager')
                  return {'statusCode': 500, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Payment authentication error'})}
              except stripe.error.StripeError as e:
                  logger.error('StripeError: %s', str(e))
                  return {'statusCode': 502, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Payment provider error'})}
              except Exception as e:
                  logger.error('Checkout error: %s', str(e), exc_info=True)
                  return {'statusCode': 500, 'headers': CORS_HEADERS,
                          'body': json.dumps({'error': 'Internal server error'})}
