  # ----------------------------------------------------------
  # COGNITO — User Pool
  # FIX #8: Added UserAttributeUpdateSettings so email
  #         changes require re-verification (security hardening)
  # Tags intentionally omitted — not supported by CFN on
  # AWS::Cognito::UserPool
  # ----------------------------------------------------------
  FixyachipsUserPool:
    Type: AWS::Cognito::UserPool
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain
    Properties:
      UserPoolName: !Sub 'Fixyachips_Global_Users-${AWS::StackName}'
      UsernameAttributes:
        - email
      AutoVerifiedAttributes:
        - email
      MfaConfiguration: OPTIONAL
      EnabledMfas:
        - SOFTWARE_TOKEN_MFA
      Policies:
        PasswordPolicy:
          MinimumLength: 12
          RequireLowercase: true
          RequireNumbers: true
          RequireSymbols: true
          RequireUppercase: true
          TemporaryPasswordValidityDays: 7
      AccountRecoverySetting:
        RecoveryMechanisms:
          - Name: verified_email
            Priority: 1
      # FIX #8: require re-verification on email change
      UserAttributeUpdateSettings:
        AttributesRequireVerificationBeforeUpdate:
          - email
      DeletionProtection: ACTIVE
      Schema:
        - Name: email
          AttributeDataType: String
          Mutable: true
          Required: true
        - Name: veteran_status
          AttributeDataType: String
          Mutable: true
        - Name: industry_segment
          AttributeDataType: String
          Mutable: true

  # FIX #9: Added CallbackURLs and LogoutURLs — required
  # fields if hosted UI is ever enabled; safe to have now.
  FixyachipsUserPoolClient:
    Type: AWS::Cognito::UserPoolClient
    Properties:
      ClientName: Fixyachips_Web_Portal
      UserPoolId: !Ref FixyachipsUserPool
      GenerateSecret: false
      ExplicitAuthFlows:
        - ALLOW_USER_SRP_AUTH
        - ALLOW_REFRESH_TOKEN_AUTH
      AccessTokenValidity: 60
      IdTokenValidity: 60
      RefreshTokenValidity: 30
      TokenValidityUnits:
        AccessToken: minutes
        IdToken: minutes
        RefreshToken: days
      PreventUserExistenceErrors: ENABLED
      EnableTokenRevocation: true
      CallbackURLs:
        - https://fixyachips.com
        - https://www.fixyachips.com
      LogoutURLs:
        - https://fixyachips.com
        - https://www.fixyachips.com
      AllowedOAuthFlowsUserPoolClient: false

