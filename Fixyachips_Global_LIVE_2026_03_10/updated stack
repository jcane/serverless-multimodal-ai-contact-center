            AbortIncompleteMultipartUpload:
              DaysAfterInitiation: 7
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
          Value: !Ref Environment
        - Key: DataClassification
          Value: Confidential

  # ----------------------------------------------------------
  # S3 BUCKET POLICY — Content Bucket
  # ----------------------------------------------------------
  BucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref StreamingVideoBucket
      PolicyDocument:
        Version: '2012-10-17'
