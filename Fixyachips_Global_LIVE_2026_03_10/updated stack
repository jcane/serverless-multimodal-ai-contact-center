        Name: !Sub 'Empire-OAC-${AWS::StackName}'
        Description: OAC for S3 — enforces sigv4, blocks direct S3 access
        OriginAccessControlOriginType: s3
        SigningBehavior: always
        SigningProtocol: sigv4

  # ----------------------------------------------------------
  # WAF — CLOUDFRONT SCOPE
  # Must be deployed in us-east-1 — confirmed correct region
