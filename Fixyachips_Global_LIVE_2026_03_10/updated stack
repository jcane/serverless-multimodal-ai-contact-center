    AllowedPattern: '^arn:aws:acm:us-east-1:[0-9]{12}:certificate/[a-f0-9\-]+$'
    ConstraintDescription: Must be a valid ACM certificate ARN in us-east-1

  Environment:
    Type: String
    Default: prod
    AllowedValues:
      - prod
      - staging
      - dev
    Description: Deployment environment

# ============================================================
# RESOURCES
# ============================================================
Resources:

  # ----------------------------------------------------------
  # CLOUDFRONT ORIGIN ACCESS CONTROL
  # ----------------------------------------------------------
