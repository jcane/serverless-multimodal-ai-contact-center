    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub '/aws/lambda/FixyachipsSignupWorker-${AWS::StackName}'
      RetentionInDays: 30
      Tags:
        - Key: Project
          Value: Fixyachips
        - Key: Environment
