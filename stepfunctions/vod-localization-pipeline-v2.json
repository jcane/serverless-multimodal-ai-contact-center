{
  "Comment": "Fixyachips VOD Localization Pipeline v2 — MediaConvert inside Map loop, Polly OutputUri wired, English bypass, 7 languages",
  "StartAt": "StartTranscribeJob",
  "States": {
    "StartTranscribeJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:transcribe:startTranscriptionJob",
      "Parameters": {
        "TranscriptionJobName.$": "States.Format('transcribe-{}', $$.Execution.Name)",
        "Media": {
          "MediaFileUri.$": "States.Format('s3://videoondemandfixyachips-source71e471f1-wlr7kazkufmk/source/{}', $.videoKey)"
        },
        "MediaFormat": "mp4",
        "LanguageCode": "en-US",
        "OutputBucketName": "videoondemandfixyachips-destination920a3c57-ykrxy0jwcztr",
        "OutputKey.$": "States.Format('transcripts/{}/transcript.json', $$.Execution.Name)"
      },
      "ResultPath": "$.transcribeJob",
      "Next": "WaitForTranscribe"
    },
    "WaitForTranscribe": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "CheckTranscribeStatus"
    },
    "CheckTranscribeStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:transcribe:getTranscriptionJob",
      "Parameters": {
        "TranscriptionJobName.$": "$.transcribeJob.TranscriptionJob.TranscriptionJobName"
      },
      "ResultPath": "$.transcribeStatus",
      "Next": "IsTranscribeComplete"
    },
    "IsTranscribeComplete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.transcribeStatus.TranscriptionJob.TranscriptionJobStatus",
          "StringEquals": "COMPLETED",
          "Next": "ExtractTranscript"
        },
        {
          "Variable": "$.transcribeStatus.TranscriptionJob.TranscriptionJobStatus",
          "StringEquals": "FAILED",
          "Next": "PipelineFailed"
        }
      ],
      "Default": "WaitForTranscribe"
    },
    "ExtractTranscript": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:980049663300:function:fixyachips-extract-transcript",
      "Parameters": {
        "transcriptBucket": "videoondemandfixyachips-destination920a3c57-ykrxy0jwcztr",
        "transcriptKey.$": "States.Format('transcripts/{}/transcript.json', $$.Execution.Name)"
      },
      "ResultPath": "$.extractedTranscript",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "PrepareLanguageArray"
    },
    "PrepareLanguageArray": {
      "Type": "Pass",
      "Result": [
        {
          "languageCode": "en-US",
          "languageShort": "en",
          "voiceId": "Matthew",
          "engine": "neural",
          "isEnglish": true
        },
        {
          "languageCode": "es-ES",
          "languageShort": "es",
          "voiceId": "Sergio",
          "engine": "neural",
          "isEnglish": false
        },
        {
          "languageCode": "pt-BR",
          "languageShort": "pt",
          "voiceId": "Ricardo",
          "engine": "standard",
          "isEnglish": false
        },
        {
          "languageCode": "fr-FR",
          "languageShort": "fr",
          "voiceId": "Remi",
          "engine": "neural",
          "isEnglish": false
        },
        {
          "languageCode": "de-DE",
          "languageShort": "de",
          "voiceId": "Daniel",
          "engine": "neural",
          "isEnglish": false
        },
        {
          "languageCode": "it-IT",
          "languageShort": "it",
          "voiceId": "Adriano",
          "engine": "neural",
          "isEnglish": false
        },
        {
          "languageCode": "pl-PL",
          "languageShort": "pl",
          "voiceId": "Jacek",
          "engine": "standard",
          "isEnglish": false
        }
      ],
      "ResultPath": "$.languages",
      "Next": "ProcessLanguages"
    },
    "ProcessLanguages": {
      "Type": "Map",
      "ItemsPath": "$.languages",
      "MaxConcurrency": 3,
      "Parameters": {
        "languageCode.$": "$$.Map.Item.Value.languageCode",
        "languageShort.$": "$$.Map.Item.Value.languageShort",
        "voiceId.$": "$$.Map.Item.Value.voiceId",
        "engine.$": "$$.Map.Item.Value.engine",
        "isEnglish.$": "$$.Map.Item.Value.isEnglish",
        "videoKey.$": "$.videoKey",
        "extractedTranscript.$": "$.extractedTranscript"
      },
      "MaxConcurrency": 3,
      "Iterator": {
        "StartAt": "IsEnglish",
        "States": {
          "IsEnglish": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.isEnglish",
                "BooleanEquals": true,
                "Next": "RunMediaConvertEnglish"
              }
            ],
            "Default": "TranslateText"
          },
          "TranslateText": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:translate:translateText",
            "Parameters": {
              "SourceLanguageCode": "en",
              "TargetLanguageCode.$": "States.ArrayGetItem(States.StringSplit($.languageCode, '-'), 0)",
              "Text.$": "$.extractedTranscript.transcriptText"
            },
            "ResultPath": "$.translationResult",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "StartPolly"
          },
          "StartPolly": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:polly:startSpeechSynthesisTask",
            "Parameters": {
              "Engine.$": "$.engine",
              "LanguageCode.$": "$.languageCode",
              "OutputFormat": "mp3",
              "OutputS3BucketName": "videoondemandfixyachips-destination920a3c57-ykrxy0jwcztr",
              "OutputS3KeyPrefix.$": "States.Format('polly/{}/{}/', $$.Execution.Name, $.languageShort)",
              "Text.$": "$.translationResult.TranslatedText",
              "TextType": "text",
              "VoiceId.$": "$.voiceId"
            },
            "ResultPath": "$.pollyJob",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "WaitForPolly"
          },
          "WaitForPolly": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "CheckPollyStatus"
          },
          "CheckPollyStatus": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:polly:getSpeechSynthesisTask",
            "Parameters": {
              "TaskId.$": "$.pollyJob.SynthesisTask.TaskId"
            },
            "ResultPath": "$.pollyStatus",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "IsPollyComplete"
          },
          "IsPollyComplete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.pollyStatus.SynthesisTask.TaskStatus",
                "StringEquals": "completed",
                "Next": "RunMediaConvertPolly"
              },
              {
                "Variable": "$.pollyStatus.SynthesisTask.TaskStatus",
                "StringEquals": "failed",
                "Next": "LanguageFailed"
              }
            ],
            "Default": "WaitForPolly"
          },
          "RunMediaConvertEnglish": {
            "Type": "Task",
            "Resource": "arn:aws:states:::mediaconvert:createJob.sync",
            "Parameters": {
              "Role": "arn:aws:iam::980049663300:role/Fixyachips-App-V1-MediaConvertRole-E0dMye487z6W",
              "Queue": "arn:aws:mediaconvert:us-east-1:980049663300:queues/FixyachipsVODQueue-Fixyachips-App-V1",
              "Settings": {
                "Inputs": [
                  {
                    "FileInput.$": "States.Format('s3://videoondemandfixyachips-source71e471f1-wlr7kazkufmk/source/{}', $.videoKey)",
                    "AudioSelectors": {
                      "Audio Selector 1": {
                        "DefaultSelection": "DEFAULT"
                      }
                    },
                    "VideoSelector": {}
                  }
                ],
                "OutputGroups": [
                  {
                    "Name": "File Group",
                    "OutputGroupSettings": {
                      "Type": "FILE_GROUP_SETTINGS",
                      "FileGroupSettings": {
                        "Destination.$": "States.Format('s3://videoondemandfixyachips-destination920a3c57-ykrxy0jwcztr/videos/{}/{}/{}-{}', $$.Execution.Name, $.languageShort, $$.Execution.Name, $.languageShort)"
                      }
                    },
                    "Outputs": [
                      {
                        "ContainerSettings": {
                          "Container": "MP4",
                          "Mp4Settings": {}
                        },
                        "VideoDescription": {
                          "CodecSettings": {
                            "Codec": "H_264",
                            "H264Settings": {
                              "RateControlMode": "QVBR",
                              "SceneChangeDetect": "TRANSITION_DETECTION",
                              "MaxBitrate": 5000000,
                              "QvbrSettings": {
                                "QvbrQualityLevel": 8
                              }
                            }
                          }
                        },
                        "AudioDescriptions": [
                          {
                            "AudioSourceName": "Audio Selector 1",
                            "CodecSettings": {
                              "Codec": "AAC",
                              "AacSettings": {
                                "Bitrate": 96000,
                                "CodingMode": "CODING_MODE_2_0",
                                "SampleRate": 22050
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            "ResultPath": "$.mediaConvertResult",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Next": "LanguageComplete"
          },
          "RunMediaConvertPolly": {
            "Type": "Task",
            "Resource": "arn:aws:states:::mediaconvert:createJob.sync",
            "Parameters": {
              "Role": "arn:aws:iam::980049663300:role/Fixyachips-App-V1-MediaConvertRole-E0dMye487z6W",
              "Queue": "arn:aws:mediaconvert:us-east-1:980049663300:queues/FixyachipsVODQueue-Fixyachips-App-V1",
              "Settings": {
                "Inputs": [
                  {
                    "FileInput.$": "States.Format('s3://videoondemandfixyachips-source71e471f1-wlr7kazkufmk/source/{}', $.videoKey)",
                    "AudioSelectors": {
                      "Audio Selector 1": {
                        "DefaultSelection": "NOT_DEFAULT"
                      },
                      "Audio Selector 2": {
                        "ExternalAudioFileInput.$": "$.pollyStatus.SynthesisTask.OutputUri",
                        "DefaultSelection": "DEFAULT"
                      }
                    },
                    "VideoSelector": {}
                  }
                ],
                "OutputGroups": [
                  {
                    "Name": "File Group",
                    "OutputGroupSettings": {
                      "Type": "FILE_GROUP_SETTINGS",
                      "FileGroupSettings": {
                        "Destination.$": "States.Format('s3://videoondemandfixyachips-destination920a3c57-ykrxy0jwcztr/videos/{}/{}/{}-{}', $$.Execution.Name, $.languageShort, $$.Execution.Name, $.languageShort)"
                      }
                    },
                    "Outputs": [
                      {
                        "ContainerSettings": {
                          "Container": "MP4",
                          "Mp4Settings": {}
                        },
                        "VideoDescription": {
                          "CodecSettings": {
                            "Codec": "H_264",
                            "H264Settings": {
                              "RateControlMode": "QVBR",
                              "SceneChangeDetect": "TRANSITION_DETECTION",
                              "MaxBitrate": 5000000,
                              "QvbrSettings": {
                                "QvbrQualityLevel": 8
                              }
                            }
                          }
                        },
                        "AudioDescriptions": [
                          {
                            "AudioSourceName": "Audio Selector 2",
                            "CodecSettings": {
                              "Codec": "AAC",
                              "AacSettings": {
                                "Bitrate": 96000,
                                "CodingMode": "CODING_MODE_2_0",
                                "SampleRate": 22050
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            "ResultPath": "$.mediaConvertResult",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Next": "LanguageComplete"
          },
          "LanguageComplete": {
            "Type": "Pass",
            "End": true
          },
          "LanguageFailed": {
            "Type": "Pass",
            "Result": "Language processing failed",
            "End": true
          }
        }
      },
      "ResultPath": "$.mapResults",
      "Next": "PipelineComplete"
    },
    "PipelineComplete": {
      "Type": "Pass",
      "Result": "All language outputs complete",
      "End": true
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "TranscribeFailed",
      "Cause": "Transcribe job did not complete successfully"
    }
  }
}
